<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- This is a TV-only app: leanback is required, touch hardware is not.
         The Skyworth reports android.software.leanback_only, so a leanback
         launcher entry is the only way it appears on the home screen. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Needed on API 30+ to resolve the speech recogniser for voice search. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- allowBackup is off deliberately. With it on and no backup-rules file,
         Android's default full-backup set ships the entire browsing profile off
         the device: history.json, bookmarks, downloads, cached favicons and the
         WebView cookie/localStorage databases. That would survive "Clear
         history" and undo private browsing on any restore. -->
    <application
        android:name=".OrbitApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:banner="@drawable/tv_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Orbit"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.BrowserActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Orbit"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize">

            <!-- LEANBACK_LAUNCHER only. Declaring plain LAUNCHER as well makes the
                 app appear twice on an Android TV home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Let other TV apps hand links to Orbit. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
